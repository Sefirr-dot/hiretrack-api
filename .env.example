# Database (used as-is when running locally; docker compose overrides DB_URL to reach the postgres service)
DB_URL=jdbc:postgresql://localhost:5432/hiretrack
DB_USERNAME=postgres
DB_PASSWORD=your_password

# JWT - base64-encoded secret of at least 256 bits, e.g.: openssl rand -base64 32
JWT_SECRET=your_base64_encoded_256bit_secret_here
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Mail - leave unset to use the Mailpit container from docker-compose (inbox UI at http://localhost:8025);
# when running the app outside Docker it defaults to localhost:1025 (Mailpit's published port).
# For real SMTP (e.g. Gmail) use:
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your@email.com
# MAIL_PASSWORD=your_app_password
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
